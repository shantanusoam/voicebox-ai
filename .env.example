# Local lab only. Use synthetic information, not patient records.
# Copy to .env and fill in. .env is gitignored; never commit a real key.
CALLBOX_HOST=127.0.0.1
CALLBOX_PORT=8787
CALLBOX_DATA_DIR=.runtime
CALLBOX_DEMO=1
# Leave empty to generate a local administrator token on first launch.
# Required and must be 32+ characters when CALLBOX_DEMO=0.
CALLBOX_ADMIN_TOKEN=
# Set to 1 only behind HTTPS. Local HTTP requires 0.
CALLBOX_SECURE_COOKIE=0

# --- Provider selection -------------------------------------------------
# openrouter | openai | none. Paid requests happen only after explicit
# per-session opt-in in the UI, whichever provider is selected.
CALLBOX_PROVIDER=none

# --- OpenRouter ---------------------------------------------------------
# Speech runs through /chat/completions, NOT /audio/speech or
# /audio/transcriptions: those routes exist but resolve no model.
# Audio output additionally requires stream:true. See docs/PROVIDERS.md.
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=google/gemini-3.8-flash
OPENROUTER_INTENT_MODEL=google/gemini-3.8-flash
OPENROUTER_TTS_MODEL=openai/gpt-audio-mini
OPENROUTER_VOICE=alloy
# Hard ceiling in USD for a single turn. A turn costing more is rejected.
CALLBOX_MAX_TURN_COST_USD=0.05

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_VOICE=coral

# --- Realtime voice (full duplex, barge-in) -----------------------------
# Uses OPENAI_API_KEY. OpenRouter cannot proxy this API.
CALLBOX_REALTIME_MODEL=gpt-realtime-2.1-mini
CALLBOX_REALTIME_VOICE=alloy
CALLBOX_REALTIME_RATE=24000
CALLBOX_REALTIME_MAX_SECONDS=300

# Optional exact origin only after a reviewed HTTPS/WSS deployment:
# CALLBOX_PUBLIC_ORIGIN=https://callbox.example.com

# --- Sarvam (India-first speech: Saaras STT, Bulbul TTS) ----------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_VOICE=anushka
