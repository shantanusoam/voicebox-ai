# Local lab only. Use synthetic information, not patient records.
# Copy to .env and fill in. .env is gitignored; never commit a real key.
CALLBOX_HOST=127.0.0.1
CALLBOX_PORT=8787
CALLBOX_DATA_DIR=.runtime
CALLBOX_DEMO=1
# Leave empty to generate a local administrator token on first launch.
# Required and must be 32+ characters when CALLBOX_DEMO=0.
CALLBOX_ADMIN_TOKEN=
# Set to 1 only behind HTTPS. Local HTTP requires 0.
CALLBOX_SECURE_COOKIE=0

# --- Legacy turn-based provider ----------------------------------------
# openrouter | openai | none. This is used by the older HTTP/audio playground.
# The voice websocket runtime is selected independently below.
CALLBOX_PROVIDER=none

# --- OpenRouter ---------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=google/gemini-3.8-flash
OPENROUTER_INTENT_MODEL=google/gemini-3.8-flash
OPENROUTER_TTS_MODEL=openai/gpt-audio-mini
OPENROUTER_VOICE=alloy
# Hard ceiling in USD for a single reported LLM turn.
CALLBOX_MAX_TURN_COST_USD=0.05

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_VOICE=coral

# --- Voice runtime ------------------------------------------------------
# openai   = native OpenAI Realtime (full duplex, provider-managed VAD)
# pipeline = local VAD + replaceable STT -> tool LLM -> TTS
CALLBOX_VOICE_RUNTIME=openai
CALLBOX_REALTIME_MODEL=gpt-realtime-2.1-mini
CALLBOX_REALTIME_VOICE=alloy
CALLBOX_REALTIME_RATE=24000
CALLBOX_REALTIME_MAX_SECONDS=300

# --- Low-cost component pipeline ---------------------------------------
# Suggested India POC: Groq Whisper STT + OpenRouter LLM + Sarvam Bulbul TTS.
# Each component is independent; the business orchestrator is unchanged.
CALLBOX_PIPELINE_STT=groq
CALLBOX_PIPELINE_LLM=openrouter
CALLBOX_PIPELINE_TTS=sarvam
# Empty = use OPENROUTER_INTENT_MODEL or OPENAI_INTENT_MODEL, matching provider.
CALLBOX_PIPELINE_LLM_MODEL=
CALLBOX_PIPELINE_VAD_RMS=220
CALLBOX_PIPELINE_SILENCE_MS=550
CALLBOX_PIPELINE_MAX_TURN_SECONDS=20

# Groq STT
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Sarvam India-first speech
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_VOICE=shubh
SARVAM_LANGUAGE=hi-IN
SARVAM_TTS_RATE=24000

# Optional exact origin only after a reviewed HTTPS/WSS deployment:
# CALLBOX_PUBLIC_ORIGIN=https://callbox.example.com
