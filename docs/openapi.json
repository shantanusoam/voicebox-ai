{
  "components": {
    "schemas": {
      "Confirmation": {
        "additionalProperties": false,
        "properties": {
          "confirm": {
            "const": true,
            "title": "Confirm",
            "type": "boolean"
          }
        },
        "required": [
          "confirm"
        ],
        "title": "Confirmation",
        "type": "object"
      },
      "DeviceCreate": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "simulator",
            "enum": [
              "simulator",
              "esp32-lab"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "maxLength": 64,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "DeviceCreate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 200,
            "minLength": 16,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "Login",
        "type": "object"
      },
      "NewCall": {
        "additionalProperties": false,
        "properties": {
          "consent": {
            "default": false,
            "title": "Consent",
            "type": "boolean"
          },
          "label": {
            "default": "Test caller",
            "maxLength": 80,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "language": {
            "default": "en",
            "enum": [
              "en",
              "hinglish"
            ],
            "title": "Language",
            "type": "string"
          },
          "provider": {
            "default": "local",
            "enum": [
              "local",
              "openai"
            ],
            "title": "Provider",
            "type": "string"
          },
          "source": {
            "default": "browser",
            "enum": [
              "browser",
              "simulator"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "title": "NewCall",
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "maxLength": 180,
            "minLength": 2,
            "title": "Address",
            "type": "string"
          },
          "business": {
            "default": "clinic",
            "enum": [
              "clinic",
              "salon",
              "service"
            ],
            "title": "Business",
            "type": "string"
          },
          "close_hour": {
            "maximum": 23.0,
            "minimum": 1.0,
            "title": "Close Hour",
            "type": "integer"
          },
          "fee": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Fee",
            "type": "integer"
          },
          "name": {
            "maxLength": 80,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "open_hour": {
            "maximum": 22.0,
            "minimum": 0.0,
            "title": "Open Hour",
            "type": "integer"
          },
          "slot_minutes": {
            "default": 30,
            "enum": [
              15,
              20,
              30,
              60
            ],
            "title": "Slot Minutes",
            "type": "integer"
          },
          "staff_label": {
            "maxLength": 80,
            "minLength": 2,
            "title": "Staff Label",
            "type": "string"
          },
          "timezone": {
            "const": "Asia/Kolkata",
            "default": "Asia/Kolkata",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "name",
          "open_hour",
          "close_hour",
          "fee",
          "address",
          "staff_label"
        ],
        "title": "Settings",
        "type": "object"
      },
      "Turn": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Request Id",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "request_id"
        ],
        "title": "Turn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
