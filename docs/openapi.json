  "components": {
    "schemas": {
      "Confirmation": {
        "properties": {
          "confirm": {
            "type": "boolean",
            "const": true,
            "title": "Confirm"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm"
        ],
        "title": "Confirmation"
      },
      "DeviceCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "simulator",
              "esp32-lab"
            ],
            "title": "Kind",
            "default": "simulator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "DeviceCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 16,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Login"
      },
      "NewCall": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Label",
            "default": "Test caller"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hinglish"
            ],
            "title": "Language",
            "default": "en"
          },
          "source": {
            "type": "string",
            "enum": [
              "browser",
              "simulator"
            ],
            "title": "Source",
            "default": "browser"
          },
          "provider": {
            "type": "string",
            "enum": [
              "local",
              "openai"
            ],
            "title": "Provider",
            "default": "local"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewCall"
      },
      "Settings": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Name"
          },
          "business": {
            "type": "string",
            "enum": [
              "clinic",
              "salon",
              "service"
            ],
            "title": "Business",
            "default": "clinic"
          },
          "timezone": {
            "type": "string",
            "const": "Asia/Kolkata",
            "title": "Timezone",
            "default": "Asia/Kolkata"
          },
          "open_hour": {
            "type": "integer",
            "maximum": 22.0,
            "minimum": 0.0,
            "title": "Open Hour"
          },
          "close_hour": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 1.0,
            "title": "Close Hour"
          },
          "slot_minutes": {
            "type": "integer",
            "enum": [
              15,
              20,
              30,
              60
            ],
            "title": "Slot Minutes",
            "default": 30
          },
          "fee": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Fee"
          },
          "address": {
            "type": "string",
            "maxLength": 180,
            "minLength": 2,
            "title": "Address"
          },
          "staff_label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Staff Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "open_hour",
          "close_hour",
          "fee",
          "address",
          "staff_label"
        ],
        "title": "Settings"
      },
      "Turn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "request_id"
        ],
        "title": "Turn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
